# Скопируйте в .env и заполните.

# Токен бота от @BotFather
BOT_TOKEN=123456789:replace-me

# Telegram ID владельцев бота через запятую (свой ID можно узнать у @userinfobot).
# Остальным бот отвечает «нет доступа».
ADMIN_IDS=123456789

# Часовой пояс для расписаний и дневных/месячных лимитов (IANA, например Europe/Moscow, America/Sao_Paulo)
TIMEZONE=Europe/Moscow

# Магазин: demo — тестовый каталог без реальных денег; bonoxs — bonoxs.com (адаптер ещё не подключён к сайту, см. README)
SHOP=demo

# Режим при самом первом запуске. Дальше переключается командой /mode и запоминается.
DRY_RUN=true

# Аккаунт bonoxs.com (понадобится адаптеру bonoxs)
BONOXS_EMAIL=
BONOXS_PASSWORD=

# Если бот был выключен в момент запуска по расписанию, покупка выполнится после включения,
# только если опоздание не больше стольких минут. Иначе запуск помечается пропущенным.
MISFIRE_GRACE_MINUTES=15

# Сколько ждать оплату (Pix/boleto) или зачисление по созданному заказу
PAYMENT_TIMEOUT_MINUTES=30
PAYMENT_POLL_SECONDS=20

DB_PATH=data/bonoxauto.db
LOG_LEVEL=INFO
